# Supabase (self-hosted)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/hotel_crm
# PostgREST JWT secret — required for RLS tenant clients (same as /etc/postgrest.conf jwt-secret)
PGRST_JWT_SECRET=your-postgrest-jwt-secret

# Server
PORT=3000
JWT_SECRET=your-jwt-secret

# Zalo
ZALO_COOKIE_PATH=data/credentials/credentials.json
ADMIN_ZALO_IDS=

# Facebook
FB_PAGE_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=

# Payment (VietQR)
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
